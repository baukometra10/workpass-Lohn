# WorkPass Accounting Bridge – copy to .env (never commit secrets)

# --- Platform (Suppix AI WorkPass) ---
WORKPASS_PLATFORM_DOMAIN=suppix-ai-workpass.com
WORKPASS_CORS_ORIGIN=https://suppix-ai-workpass.com,https://www.suppix-ai-workpass.com,https://app.suppix-ai-workpass.com
WORKPASS_PLATFORM_WEBHOOK_URL=https://suppix-ai-workpass.com/api/workpass/webhooks/accounting
# WORKPASS_PLATFORM_WEBHOOK_KEY=same-or-shared-with-platform

# --- Required in production ---
WORKPASS_STRICT=1
WORKPASS_API_KEY=change-me-to-a-long-random-secret-32chars
WORKPASS_DATA_KEY=change-me-encryption-key-separate-from-api

# Serve Rechnung + Lohn UI from the same service (Railway)
WORKPASS_SERVE_UI=1

# --- Server ---
# Railway sets PORT automatically; host becomes 0.0.0.0 when PORT is set
# WORKPASS_API_PORT=8787
# WORKPASS_API_HOST=0.0.0.0

# Force HTTPS awareness behind Railway proxy
WORKPASS_FORCE_HTTPS=1

# Volume paths on Railway
# WORKPASS_SQLITE_PATH=/data/workpass-local.sqlite
# WORKPASS_BACKUP_DIR=/data/backups

# Shared with platform webhook receiver
# WORKPASS_PLATFORM_WEBHOOK_KEY=shared-webhook-secret

# --- Optional Postgres ---
# WORKPASS_DATABASE_URL=postgres://user:pass@host:5432/workpass

# --- Encrypted backups ---
WORKPASS_BACKUP_INTERVAL_HOURS=24
WORKPASS_BACKUP_KEEP=30
# WORKPASS_BACKUP_KEY=optional-separate-backup-key

# --- Rate limit ---
# WORKPASS_RATE_LIMIT=180
# WORKPASS_MAX_BODY_BYTES=1500000
